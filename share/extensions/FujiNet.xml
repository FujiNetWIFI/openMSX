<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>FujiNet</name>
    <manufacturer>FujiNet (https://fujinet.online)</manufacturer>
    <code />
    <release_year />
    <description>FujiNet Network Adapter</description>
  </info>
  <devices>
    <!-- No <secondary>: the adapter decodes FFFFh itself. openMSX only passes
         FFFFh to a device in a slot it does not treat as expanded, and cannot
         expand a slot at run time. -->
    <primary slot="any">
      <FujiNet id="FujiNet">
        <mem base="0x4000" size="0x8000" />
        <mem base="0xC000" size="0x4000" />
        <rom>
          <filename>fujinet-config.rom</filename>
        </rom>
        <rom id="unapirom">
          <filename>fujinet-unapi.rom</filename>
        </rom>
      </FujiNet>
    </primary>
  </devices>
</msxconfig>
